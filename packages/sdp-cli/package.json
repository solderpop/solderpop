{
  "name": "sdp-cli",
  "type": "module",
  "version": "0.38.0",
  "description": "SolderPop IDE: Command Line Interface",
  "author": "SolderPop <dev@solderpop.io>",
  "bin": {
    "sdpc": "./bin/run"
  },
  "bugs": "https://github.com/solderpop/solderpop/issues",
  "dependencies": {
    "@oclif/command": "^1.5.5",
    "@oclif/config": "^1.9.0",
    "@oclif/errors": "^1.2.2",
    "@oclif/plugin-autocomplete": "^0.1.0",
    "@oclif/plugin-help": "^2.1.4",
    "@oclif/plugin-not-found": "^1.2.2",
    "as-table": "^1.0.36",
    "chalk": "^2.4.1",
    "cli-ux": "^4.9.3",
    "fs-extra": "^7.0.1",
    "listr": "^0.14.2",
    "listr-update-renderer": "^0.4.0",
    "listr-verbose-renderer": "^0.4.1",
    "node-fetch": "^2.3.0",
    "ramda": "^0.24.1",
    "source-map-support": "^0.5.9",
    "sdp-arduino": "^0.38.0",
    "sdp-deploy-bin": "^0.38.0",
    "sdp-fs": "^0.38.0",
    "sdp-func-tools": "^0.34.0",
    "sdp-project": "^0.38.0",
    "sdp-tabtest": "^0.38.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/register": "^8.0.1",
    "@oclif/dev-cli": "^1.19.4",
    "@oclif/test": "^1.2.2",
    "chai": "^4.2.0",
    "cpx": "^1.5.0",
    "nock": "^10.0.2",
    "rimraf": "^2.6.2"
  },
  "engines": {
    "node": ">=8.0.0"
  },
  "files": [
    "/bin",
    "/lib",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json",
    "/bundle"
  ],
  "homepage": "https://solderpop.io/",
  "keywords": [
    "oclif",
    "xod",
    "xodlang"
  ],
  "license": "AGPL-3.0",
  "main": "bin/run",
  "oclif": {
    "commands": "./lib/commands",
    "bin": "sdpc",
    "plugins": [
      "@oclif/plugin-autocomplete",
      "@oclif/plugin-help",
      "@oclif/plugin-not-found"
    ],
    "repositoryPrefix": "<%- repo %>/blob/main/packages/sdp-cli/<%- commandPath %>",
    "topics": {
      "install": {
        "description": "install toolchains and libraries"
      }
    }
  },
  "repository": "solderpop/solderpop",
  "scripts": {
    "clean:dist": "rimraf ./lib ./bundle",
    "build:workspace": "cpx \"../../workspace/**\" \"./bundle/workspace\"",
    "build:tabtestWorkspace": "cpx \"../sdp-tabtest/workspace/**\" \"./bundle/tabtest-workspace\"",
    "build:tabtestSrc": "cpx \"../sdp-tabtest/cpp/**\" \"./bundle/tabtest-cpp\"",
    "build:catch2": "cpx \"../../vendor/catch2/**\" \"./bundle/catch2\"",
    "build:catch2utils": "cpx \"../../cpplib/catch2utils/**\" \"./bundle/catch2utils\"",
    "build:bundle": "yarn run build:workspace && yarn run build:tabtestWorkspace && yarn run build:tabtestSrc && yarn run build:catch2 && yarn run build:catch2utils",
    "build:readme": "oclif-dev readme && sed -i -e 's/lib\\/commands\\//src\\/commands\\//g' README.md",
    "build:src": "babel src/ -d lib/ --source-maps",
    "build": "yarn run build:bundle && yarn run build:src",
    "dev": "yarn run build --watch",
    "postpack": "rm -f oclif.manifest.json",
    "test-func": "BABEL_DISABLE_CACHE=1 mocha --require ../../tools/babel-register.js --color --timeout 600000 test-func/**/*.spec.js"
  }
}
