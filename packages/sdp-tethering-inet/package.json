{
  "name": "sdp-tethering-inet",
  "type": "module",
  "version": "0.34.0",
  "scripts": {
    "refmt": "rescript format -all",
    "build:re": "rescript build",
    "build": "pnpm build:re",
    "clean:dist": "rimraf ./lib ./src/**/*.bs.js",
    "dev": "rescript build -w",
    "test": "jest"
  },
  "keywords": [
    "BuckleScript"
  ],
  "author": "SolderPop",
  "license": "AGPL-3.0",
  "main": "src/AtInternet.bs.js",
  "dependencies": {
    "address": "^1.1.2",
    "belt-holes": "workspace:^0.34.0",
    "internet-available": "^1.0.0",
    "tcp-ping": "^0.1.1",
    "@rescript/runtime": "^12.3.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "babel-jest": "^24.9.0",
    "rescript": "^12.3.0",
    "ramda": "^0.24.1"
  },
  "jest": {
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!belt-holes/)"
    ],
    "transform": {
      "^.+\\.js$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "modules": "commonjs",
                "targets": {
                  "node": "current"
                }
              }
            ]
          ]
        }
      ]
    },
    "moduleNameMapper": {
      "^@rescript/runtime/lib/es6/(.*)$": "@rescript/runtime/lib/js/$1"
    }
  }
}
