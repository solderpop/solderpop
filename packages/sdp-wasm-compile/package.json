{
  "name": "sdp-wasm-compile",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Local Emscripten-based C++ to WASM compiler for Simulation",
  "main": "dist/index.js",
  "scripts": {
    "build": "babel src/ -d dist/ --source-maps",
    "clean:dist": "rimraf ./dist",
    "dev": "pnpm run build --watch",
    "test": "mocha --require ../../tools/babel-register.js --color --timeout 30000 test/**/*.spec.js"
  },
  "keywords": [
    "xod",
    "xodlang"
  ],
  "author": "SolderPop <contact@solderpop.io>",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solderpop/solderpop.git"
  },
  "bugs": {
    "url": "https://github.com/solderpop/solderpop/issues"
  },
  "dependencies": {
    "fs-extra": "^7.0.1",
    "sdp-arduino": "workspace:*",
    "sdp-func-tools": "workspace:*",
    "which": "^1.3.1"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/register": "^8.0.1",
    "babel-plugin-inline-import": "^3.0.0",
    "chai": "^4.2.0"
  },
  "files": [
    "dist",
    "src"
  ]
}
