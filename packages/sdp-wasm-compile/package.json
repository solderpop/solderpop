{
  "name": "sdp-wasm-compile",
  "version": "0.1.0",
  "description": "Local Emscripten-based C++ to WASM compiler for Simulate, replacing the old xod.io cloud compile service",
  "main": "dist/index.js",
  "scripts": {
    "build": "babel src/ -d dist/ --source-maps",
    "clean:dist": "rimraf ./dist",
    "dev": "yarn run build --watch",
    "test": "BABEL_DISABLE_CACHE=1 mocha test/**/*.spec.js"
  },
  "keywords": [
    "xod",
    "xodlang"
  ],
  "author": "SolderPop <dev@solderpop.io>",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solderpop/solderpop.git"
  },
  "bugs": {
    "url": "https://github.com/solderpop/solderpop/issues"
  },
  "dependencies": {
    "fs-extra": "^7.0.1",
    "sdp-arduino": "^0.38.0",
    "sdp-func-tools": "^0.34.0",
    "which": "^1.3.1"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/register": "^8.0.1",
    "babel-plugin-inline-import": "^3.0.0",
    "chai": "^4.2.0"
  },
  "files": [
    "dist",
    "src"
  ]
}
