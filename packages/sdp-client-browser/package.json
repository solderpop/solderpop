{
  "name": "sdp-client-browser",
  "type": "module",
  "version": "0.38.0",
  "description": "SolderPop IDE: Client browser application",
  "scripts": {
    "build:tutorial-project": "node ./tools/loadTutorialProject.cjs",
    "build": "pnpm run build:tutorial-project && webpack --color --config webpack.config.cjs",
    "clean:dist": "rimraf ./dist ./tutorialProject.json",
    "benchmark": "node -r babel-register ./benchmark/index.js",
    "test-func": "mocha --require ../../tools/babel-register.js --color --timeout 90000 --bail test-func/bootstrap.js test-func/**/*.spec.js",
    "dev": "pnpm run build:tutorial-project && webpack-dev-server --watch --color --hot --config webpack.config.dev.cjs"
  },
  "dependencies": {
    "babel-polyfill": "^6.16.0",
    "prop-types": "^15.5.10",
    "ramda": "^0.24.1",
    "react": "^16.2",
    "react-dom": "^16.2",
    "react-event-listener": "^0.5.3",
    "react-fa": "^5.0.0",
    "react-hotkeys": "^1.1.4",
    "react-redux": "^4.4.5",
    "react-skylight": "git+https://github.com/xodio/react-skylight.git#6dc266edc5198d0d1a6feb57f329826e782ec967",
    "redux": "^3.0.5",
    "redux-thunk": "^2.1.0",
    "url-parse": "^1.2.0",
    "sdp-arduino": "workspace:^0.38.0",
    "sdp-client": "workspace:^0.38.0",
    "sdp-func-tools": "workspace:^0.34.0",
    "sdp-project": "workspace:^0.38.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "babel-loader": "^10.1.1",
    "chai": "^4.1.2",
    "css-loader": "^7.1.4",
    "expose-loader": "^5.0.1",
    "node-static": "^0.7.10",
    "postcss": "^8.5.26",
    "postcss-loader": "^8.2.1",
    "sass-loader": "^17.0.0",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1",
    "worker-loader": "^3.0.8",
    "why-did-you-update": "^0.1.0",
    "sdp-fs": "workspace:^0.38.0",
    "font-awesome": "^4.6.3"
  },
  "author": "SolderPop <dev@solderpop.io>",
  "license": "AGPL-3.0"
}
