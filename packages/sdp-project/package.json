{
  "name": "sdp-project",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "API functions to work on XOD project state",
  "keywords": [],
  "license": "AGPL-3.0",
  "author": "SolderPop <contact@solderpop.io>",
  "main": "dist/index.js",
  "repository": {},
  "scripts": {
    "build:js": "babel src/ -d dist/ --source-maps",
    "build:re": "rescript build",
    "build:built-in-patches": "node ./tools/loadBuiltinPatches.cjs",
    "build:dummy-built-in-patches": "node ./tools/makeDummyBuiltinPatches.cjs",
    "build": "pnpm run build:dummy-built-in-patches && pnpm run build:re && pnpm run build:js && pnpm run build:built-in-patches",
    "dev:re": "pnpm run build:re -w",
    "dev": "pnpm run build:js --watch",
    "refmt": "rescript format -all",
    "doc": "documentation build src/ --format html --output doc --sort-order alpha",
    "test": "mocha --require ../../tools/babel-register.js --color --timeout 10000 test/**/*.spec.js",
    "clean:dist": "rimraf ./dist ./lib ./src/**/*.bs.js",
    "test:watch": "pnpm run test --watch"
  },
  "dependencies": {
    "@rescript/runtime": "^12.3.0",
    "belt-holes": "workspace:*",
    "hm-def": "^0.3.2",
    "ramda": "^0.24.1",
    "ramda-fantasy": "^0.8.0",
    "sanctuary-def": "^0.14.0",
    "shortid": "^2.2.6",
    "sdp-func-tools": "workspace:*"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/register": "^8.0.1",
    "rescript": "^12.3.0",
    "chai": "^4.1.2",
    "documentation": "^14.0.3"
  },
  "files": [
    "dist",
    "src",
    "bsconfig.json",
    "built-in-patches.xodball"
  ]
}
