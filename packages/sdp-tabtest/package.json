{
  "name": "sdp-tabtest",
  "type": "module",
  "version": "0.38.0",
  "scripts": {
    "refmt": "rescript format -all",
    "build:lib": "node ./tools/loadTabtestLibPatches.cjs",
    "build:re": "rescript build",
    "build": "pnpm run build:re && pnpm run build:lib",
    "clean:dist": "rimraf ./lib ./src/**/*.bs.js ./test/**/*.bs.js",
    "dev": "rescript build -w",
    "test": "jest"
  },
  "keywords": [
    "BuckleScript"
  ],
  "author": "SolderPop",
  "license": "AGPL-3.0",
  "main": "src/Tabtest_Js.bs.js",
  "dependencies": {
    "belt-holes": "workspace:*",
    "sdp-arduino": "workspace:*",
    "sdp-func-tools": "workspace:*",
    "sdp-project": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@rescript/runtime": "^12.3.0",
    "babel-jest": "^24.9.0",
    "jest": "^24.5.0",
    "rescript": "^12.3.0",
    "ramda": "^0.24.1",
    "sdp-fs": "workspace:*"
  },
  "jest": {
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!belt-holes/|sdp-func-tools/)"
    ],
    "transform": {
      "^.+\\.js$": [
        "babel-jest",
        {
          "presets": [
            ["@babel/preset-env", { "modules": "commonjs", "targets": { "node": "current" } }]
          ]
        }
      ]
    },
    "moduleNameMapper": {
      "^@rescript/runtime/lib/es6/(.*)$": "@rescript/runtime/lib/js/$1"
    }
  }
}
