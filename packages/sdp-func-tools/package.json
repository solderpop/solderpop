    "sanctuary-type-identifiers": "^2.0.1"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/register": "^8.0.1",
    "rescript": "^12.3.0",
    "chai": "^4.1.2"
  },
  "files": [
    "dist",
    "src",
    "bsconfig.json"
  ]
