    "build": "pnpm run build:re && pnpm run build:js",
    "clean:dist": "rimraf ./dist ./lib ./src/**/*.bs.js",
    "dev": "pnpm run build --watch",
    "test": "mocha --require ../../tools/babel-register.js --color test/**/*.spec.js"
  },
  "dependencies": {
    "@rescript/runtime": "^12.3.0",
    "hm-def": "^0.3.2",
    "ramda": "^0.24.1",
    "ramda-fantasy": "^0.8.0",
