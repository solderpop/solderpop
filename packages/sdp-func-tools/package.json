    "@babel/preset-env": "^8.0.2",
    "@babel/register": "^8.0.1",
    "bs-platform": "7.1.1",
    "chai": "^4.1.2"
  },
  "files": [
    "dist",
    "src",
    "bsconfig.json"
  ]
