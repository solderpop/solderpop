{
  "name": "sdp-git",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "SolderPop IDE: Version control for projects (semantic changes, partial commits, local history)",
  "author": "SolderPop <contact@solderpop.io>",
  "license": "AGPL-3.0",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean:dist": "rimraf ./dist",
    "typecheck": "tsc -p .",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "fs-extra": "^11.4.0",
    "sdp-fs": "workspace:*",
    "sdp-project": "workspace:*"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^9.0.13",
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ]
}
