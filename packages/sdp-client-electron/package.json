{
  "author": "SolderPop <dev@solderpop.io>",
  "description": "SolderPop IDE for the XOD visual programming language",
  "homepage": "https://solderpop.io/",
  "license": "AGPL-3.0",
  "main": "src-babel/app/main.js",
  "name": "sdp-client-electron",
  "type": "module",
  "version": "0.38.0",
  "scripts": {
    "build:workspace": "cpx \"../../workspace/**/*\" \"src-babel/workspace\"",
    "build:gui": "webpack --color --config webpack.config.cjs",
    "build:app": "babel src/app/ -d src-babel/app/ && babel src/shared/ -d src-babel/shared/",
    "build": "pnpm run build:gui && pnpm run build:app && pnpm run build:workspace",
    "clean:dist": "rimraf ./src-babel",
    "start": "electron . --no-sandbox --ozone-platform=x11",
    "postinstall": "electron-builder install-app-deps",
    "test": "electron-mocha --no-sandbox --require ../../tools/babel-register.js --timeout 60000 ./test",
    "test-func": "mocha --require ../../tools/babel-register.js --color --timeout 60000 --bail test-func/**/*.spec.js"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "babel-polyfill": "^6.16.0",
    "rescript": "^12.3.0",
    "classnames": "^2.2.5",
    "cpx": "^1.5.0",
    "electron-context-menu": "^2.3.0",
    "electron-log": "^4.2.4",
    "electron-settings": "^4.0.2",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "fs-extra": "^4.0.2",
    "node-noop": "^1.0.0",
    "prop-types": "^15.5.10",
    "ramda": "^0.24.1",
    "ramda-fantasy": "^0.8.0",
    "rc-progress": "^2.1.2",
    "react": "^16.2",
    "react-dom": "^16.2",
    "react-event-listener": "^0.5.3",
    "react-fa": "^5.0.0",
    "react-hotkeys": "^1.1.4",
    "react-redux": "^4.4.5",
    "react-skylight": "git+https://github.com/xodio/react-skylight.git#6dc266edc5198d0d1a6feb57f329826e782ec967",
    "redux": "^3.0.5",
    "redux-thunk": "^2.1.0",
    "serialport": "^13.0.0",
    "sdp-arduino": "workspace:*",
    "sdp-client": "workspace:*",
    "sdp-deploy": "workspace:*",
    "sdp-deploy-bin": "workspace:*",
    "sdp-fs": "workspace:*",
    "sdp-func-tools": "workspace:*",
    "sdp-project": "workspace:*",
    "sdp-tethering-inet": "workspace:*",
    "sdp-wasm-compile": "workspace:*"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/register": "^7.29.7",
    "babel-loader": "^10.1.1",
    "chai": "^4.1.2",
    "chai-as-promised": "^6.0.0",
    "devtron": "^1.3.0",
    "dir-compare": "^1.4.0",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "css-loader": "^7.1.4",
    "postcss": "^8.5.26",
    "postcss-loader": "^8.2.1",
    "sass-loader": "^17.0.0",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "worker-loader": "^3.0.8",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-merge": "^6.0.1",
    "electron-devtools-installer": "^3.1.1",
    "electron-mocha": "^13.1.0",
    "fsp": "^0.1.2"
  },
  "build": {
    "appId": "io.solderpop.ide",
    "productName": "SolderPop IDE",
    "buildDependenciesFromSource": true,
    "files": [
      "**/*",
      "!**/node_modules/sdp-arduino/**/*",
      "**/node_modules/sdp-arduino/dist/**/*",
      "!**/node_modules/@rescript/runtime/**/*",
      "**/node_modules/@rescript/runtime/lib/js/**/*"
    ],
    "extraResources": [
      {
        "from": "arduino-cli",
        "to": "arduino-cli"
      },
      {
        "from": "arduino-cli.exe",
        "to": "arduino-cli.exe"
      },
      {
        "from": "src-babel/workspace",
        "to": "workspace"
      }
    ],
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "publisherName": [
        "SolderPop"
      ],
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false
    },
    "fileAssociations": [
      {
        "ext": "xod",
        "description": "SolderPop Project Manifest"
      },
      {
        "ext": "xodp",
        "description": "SolderPop Patch"
      },
      {
        "ext": "xodball",
        "description": "SolderPop Packed Project"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://releases.solderpop.io/releases/latest",
        "channel": "latest"
      }
    ]
  }
}
