{
  "name": "xod",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "SolderPop IDE monorepo (XOD-based)",
  "license": "AGPL-3.0",
  "scripts": {
    "bootstrap": "lerna bootstrap",
    "benchmark:browser": "lerna run benchmark --scope sdp-client-browser --stream",
    "build": "lerna run build --stream",
    "build:browser": "lerna run build --scope sdp-client-browser --include-filtered-dependencies --stream",
    "build:cli": "lerna run build --scope sdp-cli --include-filtered-dependencies --stream",
    "build:electron": "lerna run build --scope sdp-client-electron --include-filtered-dependencies --stream",
    "clean": "yarn run clean:dist && yarn run clean:node_modules",
    "clean:dist": "lerna run clean:dist",
    "clean:node_modules": "rimraf node_modules packages/*/node_modules",
    "dev:browser": "CHOKIDAR_USEPOLLING=1 lerna run --stream --parallel dev --scope sdp-client-browser --include-filtered-dependencies",
    "dev:cli": "CHOKIDAR_USEPOLLING=1 lerna run --stream --parallel dev --scope sdp-cli --include-filtered-dependencies",
    "dev:electron": "CHOKIDAR_USEPOLLING=1 lerna run --stream --parallel dev --scope sdp-client-electron --include-filtered-dependencies",
    "dist:electron": "electron-builder --publish always --projectDir ./packages/sdp-client-electron",
    "doc": "lerna run doc",
    "doc:fz": "cd docs && make",
    "dockerize:browser": "docker build packages/sdp-client-browser",
    "lerna": "lerna",
    "lint": "eslint packages/*/src packages/*/test packages/*/test-func tools packages/*/tools packages/*/stories packages/*/benchmark --ext js,jsx --max-warnings 0",
    "prettier-md-check": "prettier --list-different '**/*.md'",
    "prettier-md-format": "prettier --write '**/*.md'",
    "start:electron": "lerna run start --scope sdp-client-electron --stream",
    "start:spectron-repl": "./tools/spectron-repl",
    "storybook": "lerna run storybook --stream --scope sdp-client",
    "test": "XOD_HM_DEF=true lerna run test",
    "test-strict": "XOD_HM_DEF=strict lerna run test",
    "test-func": "lerna run test-func",
    "test-cpp": "lerna run test-cpp",
    "tabtest": "ls -d workspace/__lib__/xod/* workspace/test/* | xargs -n 1 yarn sdpc tabtest",
    "verify": "yarn prettier-md-check && yarn build && yarn lint && yarn test && yarn test-cpp && yarn test-func",
    "sdpc": "node packages/sdp-cli/bin/run"
  },
  "devDependencies": {
    "@google-cloud/storage": "^1.1.0",
    "docopt": "^0.6.2",
    "documentation": "^4.0.0-beta12",
    "eslint": "^3.7.0",
    "eslint-config-airbnb": "^12.0.0",
    "eslint-config-prettier": "^2.9.0",
    "eslint-plugin-import": "^1.16.0",
    "eslint-plugin-jsx-a11y": "^2.2.2",
    "eslint-plugin-mocha": "^4.9.0",
    "eslint-plugin-prettier": "^2.6.0",
    "eslint-plugin-react": "6.10.0",
    "eslint-plugin-xod-fp": "^0.1.1",
    "findup-sync": "^2.0.0",
    "lerna": "2.11.0",
    "mocha": "^11.8.0",
    "node-gyp": "^13.0.1",
    "prettier": "^1.11.1",
    "puppeteer": "^1.20.0",
    "rimraf": "^2.5.4",
    "spectron": "^12.0.0"
  },
  "resolutions": {
    "**/ramda-fantasy/ramda": "^0.24.1",
    "**/electron-is-dev": "^2.0.0",
    "**/spdy": "file:./tools/spdy-shim"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
