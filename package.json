{
  "name": "SolderPop",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "SolderPop IDE monorepo",
  "license": "AGPL-3.0",
  "scripts": {
    "benchmark:browser": "turbo run benchmark --filter=sdp-client-browser",
    "build": "turbo run build",
    "build:browser": "turbo run build --filter=sdp-client-browser...",
    "build:cli": "turbo run build --filter=sdp-cli...",
    "build:electron": "turbo run build --filter=sdp-client-electron...",
    "clean": "pnpm run clean:dist && pnpm run clean:node_modules",
    "clean:dist": "turbo run clean:dist",
    "clean:node_modules": "rimraf node_modules packages/*/node_modules",
    "dev:browser": "CHOKIDAR_USEPOLLING=1 turbo run dev --filter=sdp-client-browser...",
    "dev:cli": "CHOKIDAR_USEPOLLING=1 turbo run dev --filter=sdp-cli...",
    "dev:electron": "CHOKIDAR_USEPOLLING=1 turbo run dev --filter=sdp-client-electron...",
    "dist:electron": "electron-builder --publish always --projectDir ./packages/sdp-client-electron",
    "doc": "turbo run doc",
    "doc:fz": "cd docs && make",
    "dockerize:browser": "docker build packages/sdp-client-browser",
    "lint": "eslint packages/*/src packages/*/test packages/*/test-func tools packages/*/tools packages/*/stories packages/*/benchmark --ext js,jsx,ts,tsx --max-warnings 0 --no-error-on-unmatched-pattern",
    "prettier-md-check": "prettier --list-different '**/*.md'",
    "prettier-md-format": "prettier --write '**/*.md'",
    "start:electron": "turbo run start --filter=sdp-client-electron",
    "start:spectron-repl": "./tools/spectron-repl",
    "storybook": "turbo run storybook --filter=sdp-client",
    "test": "XOD_HM_DEF=true turbo run test",
    "test-strict": "XOD_HM_DEF=strict turbo run test",
    "test-func": "turbo run test-func",
    "test-cpp": "turbo run test-cpp",
    "typecheck": "turbo run typecheck",
    "tabtest": "ls -d workspace/__lib__/xod/* workspace/test/* | xargs -n 1 pnpm sdpc tabtest",
    "verify": "pnpm prettier-md-check && pnpm build && pnpm lint && pnpm test && pnpm test-cpp && pnpm test-func",
    "sdpc": "node packages/sdp-cli/bin/run"
  },
  "devDependencies": {
    "@google-cloud/storage": "^1.1.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "documentation": "^4.0.0-beta12",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-mocha": "^10.5.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-sdp-fp": "file:./tools/eslint-plugin-sdp-fp",
    "findup-sync": "^2.0.0",
    "fs-extra": "^4.0.2",
    "mocha": "^11.8.0",
    "node-gyp": "^13.0.1",
    "prettier": "^3.9.6",
    "puppeteer": "^1.20.0",
    "ramda": "^0.24.1",
    "rimraf": "^2.5.4",
    "sdp-fs": "workspace:^0.38.0",
    "spectron": "^12.0.0",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
